[Unit]
Description=freshGram release notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freshupdate
Group=freshupdate
WorkingDirectory=/opt/freshupdate
ExecStart=/usr/bin/node /opt/freshupdate/dist/main.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/freshupdate/data

[Install]
WantedBy=multi-user.target
