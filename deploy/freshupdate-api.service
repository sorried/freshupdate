[Unit]
Description=Freshupdate authenticated webhook API and release tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freshupdate
Group=freshupdate
WorkingDirectory=/opt/freshupdate
EnvironmentFile=/etc/freshupdate/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/freshupdate/dist/webhook.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
StateDirectory=freshupdate
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
PrivateUsers=true
RemoveIPC=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
